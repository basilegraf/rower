# COMET special parameters
# ISO linear units : m,  m/s,  m/s²,  V,  A,  s
# ISO rotary units : t,  t/s,  t/s²,  V,  A,  s

void func3(void);
void aviron(void);
float cbrtf(float x); // Cubic root approximation
float absolutValue(float x); // |x|

void autostart(void) {
   // Init values
	x0.0 = 0;
   xf0.0 = 0.0f;
	xf0.1 = 0.0f;
   // Power ON both axes
   WTT.1 = 1000; // Wait  1000*400us = 0.4sec (MLTI's)
	pwr.0 = 1;
	pwr.1 = 1;
	WTT.1 = 5000; // Wait  5000*400us = 2sec (MLTI's)
	// Deactivate cogging compensation
	k119.0 = 0;
	// Start the rowing sequence
   //func3();
	aviron();
}

// Unused...
void func0(void)
{
	float force = 0.0f;
	xf0.1 = 3.0f;
	x0.0 = 1;
	while (x0.0 == 1)
	{
		if (M11.0 > 0)
		{
			force = -1.9e-7f * M11.0;
			if (force < -3.0f) force = -3.0f;
			if (force > 0.0f)  force = 0.0f;
			xf0.0 = force;
		}
		else
		{
			xf0.0 = 0.0f;
		}
	}
	xf0.0 = 0.0f;
	xf0.1 = 0.0f;
}


void func1(void)
{
	x0.0 = 0;
   xf0.0 = 0.0f;
	xf0.1 = 0.0f;
}






void func2(void)
{
	x0.0 = 0;
   xf0.0 = 0.0f;
	xf0.1 = 0.0f;
	pwr.(0,1) = 1;
}


// Rowing function
// Regulating output power
void func3(void)
{
	// TODO: Check power ON
	float force = 0.0f;
	float iRef = 0.0f;
	float Pow = 0.0f;
	float PowRef = 0.0f;
	float UbusErr = 0.0f;
	float pow2curGain = 0.0f;
	xf0.1 = 3.0f;
	x0.0 = 1;
	while (x0.0 == 1)
	{
		if (M11.0 > 0)
		{
			// Motor force (proportional to speed)
			// ===================================
			force = -2.5e-7f * M11.0; //-1.9e-7f 
			if (force < -5.0f) force = -5.0f;
			if (force > 0.0f)  force = 0.0f;
			xf0.0 = force; // Motor force
			// Dissipation
			// ===========
			// xf0.1     : phase 0 current ref [A]
			// MF24:0.1  : PWM value pahes 0 : 0 <=> 0V,  1250 <=> Ubus
			// M91.1     : 100*Ubus
			//  Power = 8e-6 * xf0.1 * mf24:0.1 * m91.1
			Pow = 8e-6f * xf0.1 * mf24:0.1 * m91.1;
			// Compute desired dissipation power
			PowRef = 0.0f;
			UbusErr = m91.1 - 8200; // Ubus - 52V 
			if (UbusErr > 0)
			{
				// Max admissible ubus = 92V => 270W/(92V-52V) = 6.75
				PowRef += 6.75e-2f * UbusErr;
			}
			xf10.1 = PowRef; // Store for monitoring
			xf11.1 = Pow; // Store for monitoring
			// Proportional gain on current to achieve desired power
			pow2curGain = -0.04f; // -0.02f
			iRef = pow2curGain * PowRef;
			if (iRef < -6.2f) iRef = -6.2f;
			if (iRef > 0.0f)  iRef = 0.0f;
			xf0.1 = iRef; // Dissipation current
		}
		else
		{
			xf0.0 = 0.0f;
		}
	}
	xf0.0 = 0.0f;
	xf0.1 = 0.0f;
}




void func10(void)
{
	xf10.0 = sqrtf(xf9.0);
	xf11.0 = cbrtf(xf9.0);
}


// Based on
//   http://avironplaisirpassion.free.fr/technique/conversion_temps_ergo_flotte.htm
void aviron(void)
{
	// Load resistance
	//float loadR = 2.0f * (47.0f / 6.0f); // 2 series of 6 47R in parallel
	float loadR = 16.8f; // Measured value (including coil)
	float loadInvR = 1.0f / loadR;
	float loadIref = 0.0f;	// Load real current
	float loadIreal = 0.0f; // Load real current
	// Motor data
	float motKt  = 3.61f / sqrtf(2.0f);  // [Nm/A] instead of [Nm/Arms]
	float motKu  = 2.09f * sqrtf(2.0f);  // [Vtt*s/rad]
	float motR2  = 3.29f;     // [Ohm]
	float motL1  = 19.0e-3f;  // [H]
	float motRadius = 0.036f; // [m] Pulley wheel radius
	float omega = 0.0f;   // Motor speed [rad/s]
	float motIref = 0.0f; // Motor reference current
	float motIreal = 0.0f; // Motor real current
   float alpha = 0.0f; // Motor angle [rad]
   float motIpullBack = 0.0f; // Additional current to pull back rope
	// Paddle 
	float kappa = 20.0f; // Schlupf, some large number
	float rho = 3.5f;     // Paddle length ratio, was 2.5

	// Propulsion force to motor current
	float fProp2Imot = (motRadius * rho) / motKt;

	// Increment convertions
	// =====================
	// Motor speed TODO: recompute from formula
	float motInc2Omega = 8.0f*1.4980281E-6f; // Real speed conversion factor M11.0 -> rad/s
	
	float interpFac = 1.0f * m241.0;
	float NPCOD = 1.0f * k241.0;
	float motInc2alpha = 2.0f * 3.14159265f / (interpFac * NPCOD);// Real angle conversion ML1.0 -> rad
	// Current increment -> A 
	float driveImax = m82.0 / 100.0f;
	float ci2Amp = driveImax/32768.0f;
	float amp2ci = 32768.0f/driveImax;

	// Boat equation :
   // ===============
   // vBoat = kFac * Power^(1/3) / mass^(2/9)
	//
	//    vBoat : boat speed in water   [m/s]
   //    mass  : boat + rower mass ~75 [kg]
   // 	Power : Rower power           [W]
	//    kFac  : constant ~6.0 for km/h => 6.0/3.6 for m/s
	
	float kFac = 6.0f / 3.6f;
	float mass = 60 + 15; // [kg]
	// Boat position state
	float x   = 0.0f;  // Position
	float xt  = 0.0f;  // Speed
	float xtt = 0.0f;  // Acceleration
	// Derived constants
	float invMass = 1.0f / mass;
	float speedSqrdDrag = 1.0f / (cbrtf(mass) * kFac*kFac*kFac);
	// Intermediate variables
	float fProp = 0.0f; // Boat propulsion force
	// ML228 : Time in multiples of 25us
	long counterPrev = ml228.0; 
	long counterNow  = ml228.0;
	float counterDiff = 0;
	float h; // Time in seconds between two loops

	// Powers
	float powerRower = 0.0f;       // [W]
	float powerRowerReal = 0.0f;	 // [W]
	// Energy
	float energyRowerReal = 0.0f;  // [W*s]=[Joules]

	// Main loop
	// =========
	x0.0 = 1;
	while (x0.0 == 1)
	{
		// Measurements
		// ============
		// Motor speed
		omega = M11.0;
		omega *= motInc2Omega;
		
		// Motor angle
		alpha = ML1.0;
		alpha *= motInc2alpha;

		// Currents
		motIreal = ci2Amp * MF31.0;
		loadIreal = ci2Amp * MF31.1;

		// Rope pull-back current as a function of rope length
		motIpullBack = 0.3f + 0.2f * motRadius * alpha;
		if (motRadius * alpha < 0.02f)
		{
			motIpullBack = 0.0f;
		}

		// Propulsion force equation (with Schlupf kappa)
		// fProp = kappa * max(0, rho * motRadius * omega - xt)^2
		fProp = rho * motRadius * omega - xt;
		if (fProp < 0.0f)
		{
			fProp = 0.0f;
		}
		fProp *= fProp;
		fProp *= kappa;
		
		// Motor current reference
		motIref = fProp2Imot * fProp + motIpullBack;

		// Theoretical rower power
		powerRower = motIref * motKt * omega; 
		if (powerRower < 0.0f)
		{	// Avoid negative value (sqrt)
			powerRower = 0.0f;
		}

		// Real rower power
		powerRowerReal = -1.0f * motIreal * motKt * omega; // Negative current
		if (powerRowerReal < 0.0f)
		{	// Avoid negative value (sqrt)
			powerRowerReal = 0.0f;
		}

		// Send theoretical rower power to load 
		//loadIref = sqrtf(loadInvR * powerRower); // WHY ??
		// Send real rower power to load 
		loadIref = sqrtf(loadInvR * powerRowerReal); 

		// Apply reference currents
		xf0.0 = -motIref;
		xf0.1 = loadIref;

		// Boat motion equation
		xtt = invMass * fProp - speedSqrdDrag * absolutValue(xt) * xt;
		// Integrate simulation states
		counterNow = ml228.0;
		counterDiff = counterNow - counterPrev;
		counterPrev = counterNow;
		h = 25e-6f * counterDiff;
		x  += h * xt;
		xt += h * xtt;
		// Integrate Rower energy in Joules
		energyRowerReal += h * powerRowerReal;
		// Publish values for monitoring
		xf9.0  = x;  // Boat position
		xf10.0 = xt; // Boat speed
		xf11.0 = motRadius * omega; // chain speed
		xf12.0 = omega;
		xf13.0 = energyRowerReal;
	
		xf20.0 = motRadius * alpha; // Rope length
	}
}


// Cubic root approximation
float cbrtf(float x)
{
	int k;
	float xk = x;
	for (k=0; k<10; k++)
	{
		xk = xk - (xk*xk*xk - x)/(3.0f * xk*xk);
	}
	return xk;
}

// Take the absolute value of a number
float absolutValue(float x)
{
	if (x > 0.0f) 
	{
		return x;
	}
	else 
	{
 		return -x;
	}
}











