# COMET special parameters
# ISO linear units : m,  m/s,  m/s²,  V,  A,  s
# ISO rotary units : t,  t/s,  t/s²,  V,  A,  s

#define _SPI_AXIS_ 1
#define _MOT_AXIS_ 0
#define _LOAD_AXIS_ 1
#define _SPI_BUFFER_SIZE_ 8

#define SPI_DATTA_RECEIVED 0x2

int spiBuffer[_SPI_BUFFER_SIZE_];

void configSPIAsMaster(void);
int configSPIAsSlave(void);

void send4ByteIntegerAsMaster(int);
void sendSPIBufferAsMaster(void);

void mainloopAsMaster(void);
void mainloopAsSlave(void);

void initialiseSpiBuffer(void);
void fillSpiBuffer(void);

void autostart(void)
{
	# mainloopAsMaster();
}

void func1(void)
{
	#mainloopAsMaster();
}

void func2(void)
{
	mainloopAsSlave();
}

void func3(void)
{
	configSPIAsMaster();
}

void func4(void)
{
	configSPIAsSlave();
}

void initialiseSpiBuffer(void)
{
	spiBuffer[0] = 0;
	spiBuffer[1] = 0;
	spiBuffer[2] = 0;
	spiBuffer[3] = 0;
	spiBuffer[4] = 0;
	spiBuffer[5] = 0;
	spiBuffer[6] = m90._MOT_AXIS_;
	spiBuffer[7] = m90._LOAD_AXIS_; # Temperature
}

void fillSpiBuffer(void)
{
	int pos = xf9._MOT_AXIS_;
	int speed10 = 10.0f * xf10._MOT_AXIS_;
	int energyRowerReal = xf13._MOT_AXIS_;
	int totalRowingTime = xf14._MOT_AXIS_;
	int numStrokesPerMin10  = 10.0f * xf15._MOT_AXIS_;
	int avStrokePower  = (xf16._MOT_AXIS_ + 0.5f);

	spiBuffer[0] = pos;
	spiBuffer[1] = speed10;
	spiBuffer[2] = energyRowerReal; # Joule [W*s]
	spiBuffer[3] = totalRowingTime;
	spiBuffer[4] = numStrokesPerMin10;
	spiBuffer[5] = avStrokePower;
	spiBuffer[6] = m90._MOT_AXIS_;
	spiBuffer[7] = m90._LOAD_AXIS_; # Temperature
}

void mainloopAsMaster(void)
{
	# SPI Configuration
	configSPIAsMaster();
	# Pause
	wtt.1 = 100;	
	
	initialiseSpiBuffer();

	# loop and send data
	while (1)
	{
		wtt._SPI_AXIS_ = 1000;
		fillSpiBuffer();
		sendSPIBufferAsMaster();
	}
}

void mainloopAsSlave(void)
{
	int dataToArduino = 0;
	int arduinoCommand = 0; 
	int config = 0;

	# SPI Configuration
	config = configSPIAsSlave();
	# Pause
	wtt.1 = 100;

	dataToArduino = 22;

	X0._SPI_AXIS_ = 0;
	X1._SPI_AXIS_ = 0;

	while (1)
	{
		while ((M260._SPI_AXIS_ & 0x1) != 0); # buffer out (C40) is empty and can be writen to when bit0=0
		C40._SPI_AXIS_ = dataToArduino; # Prepare data sent to master	
		X1._SPI_AXIS_ = dataToArduino;
	
		while ((M260._SPI_AXIS_ & 0x2) == 0); // bit1==0 => trasmission in progress
			
		# Read data received from master
		arduinoCommand = M261._SPI_AXIS_;
		X0._SPI_AXIS_ = arduinoCommand;
		
		C41:0._SPI_AXIS_ = config; # ??? Does not wok without resetting the config each time
					   # but then cannot send more than 1byte/500ms from arduino master...
		
		dataToArduino++;
		if (dataToArduino > 250) dataToArduino = 0;
		
	}
	

}


void configSPIAsMaster(void)
{
	int config = 0;
	# SPI Configuration as master
	c361:1._SPI_AXIS_ = 1 << 0; # SPI clock output on FDOUT1, non-inverted
	C306:1._SPI_AXIS_ = 0; # Disable slave clock input
	C360:1._SPI_AXIS_ = 1 << 1; # MOSI data output on FDOUT2, non-inverted
	C305:1._SPI_AXIS_ = 1 << 0; # MISO data input on FDIN1, non-inverted
	C362:1._SPI_AXIS_ = 1 << 2; # Chip select on FDOUT3, non-inverted (we will not use it)
	C307:1._SPI_AXIS_ = 0; # Disable chip select output 
	# SPI Message configuration
	config += 1 << 0;  # bit 0: Master mode
	config += 0 << 1;  # bit 1: CPHA: 0 => data capture on clock rising edge
	config += 0 << 2;  # bit 2: MSB first
							 # bit 3: not used
	config += 7 << 4;	 # bit 4-6: Clock frequency = 7:39kHz, 3:625kHz
							 # bit 7: not used
	config += 0 << 8;	 # bit 8-9: data size 8bits	
							 # bit 10-15: not used
	config += 0 << 16; # bit 16: CRC disabled
	config += 0 << 17; # bit 17-19: CRC size
							 # bit 20-21: not used
	config += 0 << 22; # bit 22-23: CRC error management
	C41:0._SPI_AXIS_  = config;
}

int configSPIAsSlave(void)
{
	int config = 0;
	# SPI Configuration as slave
	c361:1._SPI_AXIS_ = 0; # Disbale clock output
	C306:1._SPI_AXIS_ = 1 << 1; # SPI clock input on FDIN2
	C360:1._SPI_AXIS_ = 1 << 1; # MISO data output on FDOUT2, non-inverted
	C305:1._SPI_AXIS_ = 1 << 0; # MOSI data input on FDIN1, non-inverted
	C362:1._SPI_AXIS_ = 0; # Disable chip select out 
	C307:1._SPI_AXIS_ = 1 << 2; # Chip select input on FDIN3 
	# SPI Message configuration
	config += 0 << 0;  # bit 0: Slave mode
	config += 0 << 1;  # bit 1: CPHA: 0 => data capture on clock rising edge
	config += 0 << 2;  # bit 2: MSB first
							 # bit 3: not used
	config += 3 << 4;	 # bit 4-6: Clock frequency = 7:39kHz, 5:156kHz 3:625kHz
							 # bit 7: not used
	config += 0 << 8;	 # bit 8-9: data size 8bits	
							 # bit 10-15: not used
	config += 0 << 16; # bit 16: CRC disabled
	config += 0 << 17; # bit 17-19: CRC size
							 # bit 20-21: not used
	config += 0 << 22; # bit 22-23: CRC error management
	C41:0._SPI_AXIS_  = config;
}


void send4ByteIntegerAsMaster(int val)
{
	# Send least significant byte fisrt
	c40._SPI_AXIS_ = (val >> 0)  & 255;
	c40._SPI_AXIS_ = (val >> 8)  & 255;
	c40._SPI_AXIS_ = (val >> 16) & 255;
	c40._SPI_AXIS_ = (val >> 24) & 255;
}

void sendSPIBufferAsMaster(void)
{
	int i;
	for (i=0; i<_SPI_BUFFER_SIZE_; i++)
	{
		send4ByteIntegerAsMaster(spiBuffer[i]);
	}
}









